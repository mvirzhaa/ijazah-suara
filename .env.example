# Salin berkas ini menjadi .env lalu sesuaikan
POSTGRES_PASSWORD=ganti-kata-sandi-ini-dengan-password-yang-kuat

# Identitas institusi yang tercetak di ijazah (dan ikut di-hash SHA-256)
INSTITUTION_NAME=Universitas Ibn Khaldun Bogor
INSTITUTION_SUBTITLE=Fakultas Teknik dan Sains - Program Studi Teknik Informatika
INSTITUTION_CITY=Bogor

# Alamat publik aplikasi (tercetak di ijazah sebagai URL verifikasi)
# Untuk produksi di server:
# PUBLIC_BASE_URL=https://vr.ti.fts.uika-bogor.ac.id/ijazah-bersuara
# Untuk lokal:
PUBLIC_BASE_URL=http://localhost:3000

# Subpath URL jika aplikasi tidak diletakkan di root domain.
# Otomatis diambil dari pathname PUBLIC_BASE_URL jika tidak diset manual.
# Contoh di server: BASE_PATH=/ijazah-bersuara
BASE_PATH=

# Token untuk mendaftarkan suara dan menerbitkan ijazah.
# WAJIB diisi bila aplikasi dapat diakses orang lain / jaringan publik.
ADMIN_TOKEN=

# Codec 2: 3200 = kualitas terbaik (QR versi 30), 2400 = QR lebih kecil dengan kualitas hampir sama
CODEC2_MODE=3200

# Ambang kemiripan suara (persen)
MATCH_THRESHOLD=80

# Tolak penerbitan bila suara pernyataan tidak cocok dengan sampel penanda tangan (true/false)
ISSUANCE_VOICE_CHECK=true
